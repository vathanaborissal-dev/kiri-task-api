{
  "name": "kiri-task-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "bot": "tsx watch --env-file=.env src/bot.ts",
    "telegram:webhook": "tsx --env-file=.env scripts/telegram-webhook.ts",
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "node --env-file=.env dist/server.js",
    "start:bot": "node --env-file=.env dist/bot.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "npm run test:api && npm run test:standup && npm run test:telegram && npm run test:jobs && npm run test:portfolio",
    "test:api": "node --env-file=.env --test tests/api.test.mjs",
    "test:standup": "tsx --env-file=.env --test tests/standup.test.mjs",
    "test:telegram": "tsx --env-file=.env --test tests/telegram.test.mjs",
    "test:jobs": "tsx --env-file=.env --test tests/jobs.test.mjs",
    "db:seed:team": "tsx --env-file=.env prisma/seed-team.ts",
    "test:portfolio": "tsx --test tests/portfolio.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
