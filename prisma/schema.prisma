// Kiri Task — Project & Task Management System
// Postgres (Supabase) + Prisma

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleScope {
  GLOBAL
  PROJECT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Severity {
  MINOR
  MAJOR
  CRITICAL
  BLOCKER
}

enum TaskType {
  TASK
  FEATURE
  BUG
  IMPROVEMENT
  CHORE
  HOTFIX
}

enum QaStatus {
  NOT_REQUIRED
  PENDING
  IN_TESTING
  PASSED
  FAILED
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  READY_FOR_TESTING
  RESOLVED
  CLOSED
  REOPENED
  WONT_FIX
}

enum ReleaseStatus {
  PLANNED
  IN_DEVELOPMENT
  READY
  RELEASED
  CANCELED
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum HotfixStatus {
  REQUESTED
  APPROVED
  IN_PROGRESS
  IN_TESTING
  READY
  DEPLOYED
  VERIFIED
  REJECTED
}

enum LinkType {
  BLOCKS
  BLOCKED_BY
  RELATES_TO
  DUPLICATES
  DUPLICATED_BY
  FIXES
  FIXED_BY
}

enum EntityType {
  PROJECT
  TASK
  ISSUE
  RELEASE
  HOTFIX
  MILESTONE
  COMMENT
  USER
  ROLE
}

enum NotificationEvent {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_UPDATED
  TASK_DELETED
  TASK_STATUS_CHANGED
  TASK_PHASE_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_COMMENT
  ISSUE_REPORTED
  ISSUE_ASSIGNED
  ISSUE_UPDATED
  ISSUE_DELETED
  ISSUE_STATUS_CHANGED
  ISSUE_COMMENT
  MENTION
  HOTFIX_REQUESTED
  HOTFIX_STATUS_CHANGED
  RELEASE_STATUS_CHANGED
  DEPLOYMENT_RECORDED
  PROJECT_MEMBER_ADDED
  MILESTONE_DUE_SOON
  STANDUP_BLOCKER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum SavedFilterScope {
  TASK
  ISSUE
}

// ---------------------------------------------------------------------------
// Identity, roles & permissions
// ---------------------------------------------------------------------------

/// A role is fully data-driven: an admin can create any role and tick any
/// permission from the catalog in `src/config/permissions.ts`.
model Role {
  id           String    @id @default(cuid())
  key          String    @unique
  name         String
  description  String?
  scope        RoleScope
  /// Permission keys from the catalog, e.g. "task:create".
  permissions  String[]  @default([])
  /// Permissions the seed has already handed this role after its first
  /// version, so withdrawing one by hand is not undone on the next run.
  grantedLater String[]  @default([])
  /// System roles are seeded and cannot be deleted (but can be edited).
  isSystem     Boolean   @default(false)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users          User[]
  projectMembers ProjectMember[]
  invitations    Invitation[]

  @@index([scope])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String?
  avatarUrl          String?
  avatarPublicId     String?
  jobTitle           String?
  /// Free-text description of what this person is responsible for org-wide.
  responsibilities   String?
  timezone           String    @default("Asia/Phnom_Penh")
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  /// Newest "What's new" entry this person has read, so the sidebar only
  /// nags about releases they have not seen.
  changelogSeenAt    DateTime?
  /// Set the first time somebody dismisses the getting-started guide.
  guideSeenAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  globalRoleId String
  globalRole   Role   @relation(fields: [globalRoleId], references: [id])

  // Telegram link
  telegramChatId   BigInt?   @unique
  telegramUsername String?
  telegramLinkedAt DateTime?

  refreshTokens        RefreshToken[]
  telegramLinkTokens   TelegramLinkToken[]
  notificationSettings NotificationSetting[]
  notifications        Notification[]        @relation("NotificationRecipient")
  actedNotifications   Notification[]        @relation("NotificationActor")
  savedFilters         SavedFilter[]
  dailyPlans           DailyPlan[]

  memberships     ProjectMember[]
  ownedProjects   Project[]       @relation("ProjectOwner")
  createdProjects Project[]       @relation("ProjectCreator")

  reportedTasks  Task[]          @relation("TaskReporter")
  taskAssignees  TaskAssignee[]
  taskWatchers   TaskWatcher[]
  checklistItems ChecklistItem[]

  reportedIssues Issue[]        @relation("IssueReporter")
  assignedIssues Issue[]        @relation("IssueAssignee")
  issueWatchers  IssueWatcher[]

  requestedHotfixes Hotfix[] @relation("HotfixRequester")
  assignedHotfixes  Hotfix[] @relation("HotfixAssignee")

  createdReleases Release[]    @relation("ReleaseCreator")
  deployments     Deployment[] @relation("DeploymentActor")

  comments        Comment[]
  attachments     Attachment[]
  activities      ActivityLog[]
  sentInvitations Invitation[]     @relation("InvitationInviter")
  mentions        CommentMention[]

  @@index([globalRoleId])
  @@index([isActive])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the raw token; the raw value only ever lives in the cookie.
  tokenHash  String    @unique
  /// Rotation family — revoking one revokes the whole chain.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Invitation {
  id            String           @id @default(cuid())
  email         String
  name          String?
  tokenHash     String           @unique
  roleId        String
  role          Role             @relation(fields: [roleId], references: [id])
  status        InvitationStatus @default(PENDING)
  invitedById   String
  invitedBy     User             @relation("InvitationInviter", fields: [invitedById], references: [id])
  /// Optional project assignments applied on acceptance: [{projectId, roleId}]
  projectGrants Json?
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([email])
  @@index([status])
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  /// Short code used for task keys, e.g. "KIRI" -> KIRI-12
  key         String        @unique
  name        String
  description String?
  color       String        @default("#6366f1")
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  ownerId     String
  owner       User   @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  taskCounter   Int @default(0)
  issueCounter  Int @default(0)
  hotfixCounter Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       ProjectMember[]
  phases        ProjectPhase[]
  statuses      TaskStatus[]
  labels        Label[]
  tasks         Task[]
  issues        Issue[]
  releases      Release[]
  hotfixes      Hotfix[]
  milestones    Milestone[]
  comments      Comment[]
  attachments   Attachment[]
  activities    ActivityLog[]
  notifications Notification[]
  savedFilters  SavedFilter[]

  @@index([status])
  @@index([ownerId])
}

model ProjectMember {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role     @relation(fields: [roleId], references: [id])
  /// What this person is responsible for on this project.
  responsibilities String?
  joinedAt         DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([roleId])
}

/// Development lifecycle phase / environment (Development -> UAT -> Pilot -> Production).
model ProjectPhase {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key          String
  name         String
  description  String?
  color        String  @default("#64748b")
  order        Int
  /// The final phase ("Production") — used for release / hotfix reporting.
  isProduction Boolean @default(false)

  tasks       Task[]
  issues      Issue[]
  releases    Release[]
  deployments Deployment[]

  @@unique([projectId, key])
  @@index([projectId, order])
}

/// Customisable per-project task status (the work status column on the board).
model TaskStatus {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  name      String
  category  StatusCategory
  color     String         @default("#64748b")
  order     Int
  /// Status applied to newly created tasks.
  isDefault Boolean        @default(false)

  tasks Task[]

  @@unique([projectId, key])
  @@index([projectId, order])
}

model Label {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String  @default("#64748b")

  tasks  TaskLabel[]
  issues IssueLabel[]

  @@unique([projectId, name])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id          String   @id @default(cuid())
  key         String   @unique
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        TaskType @default(TASK)
  priority    Priority @default(MEDIUM)

  /// Work status (customisable per project).
  statusId String
  status   TaskStatus @relation(fields: [statusId], references: [id])

  /// Lifecycle phase the work has reached (Development / UAT / Pilot / Production).
  phaseId String?
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id])

  /// Testing state, tracked separately from the work status.
  qaStatus QaStatus @default(NOT_REQUIRED)

  reporterId String
  reporter   User   @relation("TaskReporter", fields: [reporterId], references: [id])

  parentTaskId String?
  parentTask   Task?   @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("Subtasks")

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  /// The issue this task works towards. One issue can have many tasks.
  issueId String?
  issue   Issue?  @relation("IssueTasks", fields: [issueId], references: [id], onDelete: SetNull)

  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  estimateHours Float?
  spentHours    Float?
  /// Self-reported completion, 0-100. Forced to 100 by a DONE status.
  progress      Int       @default(0)
  /// Board ordering within a status column.
  position      Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees      TaskAssignee[]
  watchers       TaskWatcher[]
  labels         TaskLabel[]
  checklist      ChecklistItem[]
  linksFrom      TaskLink[]      @relation("LinkSource")
  linksTo        TaskLink[]      @relation("LinkTarget")
  comments       Comment[]
  attachments    Attachment[]
  activities     ActivityLog[]
  notifications  Notification[]
  /// Issues that nominate this task as their primary fix.
  issues         Issue[]         @relation("IssuePrimaryTask")
  hotfixes       Hotfix[]
  dailyPlanItems DailyPlanItem[]

  @@index([projectId, statusId])
  @@index([projectId, dueDate])
  @@index([projectId, phaseId])
  /// Portfolio trend reads completed/created work by week across every project.
  @@index([projectId, completedAt])
  @@index([projectId, createdAt])
  @@index([parentTaskId])
  @@index([releaseId])
  @@index([milestoneId])
  @@index([issueId])
}

model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model TaskWatcher {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskLabel {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isDone      Boolean   @default(false)
  order       Int       @default(0)
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  completedAt DateTime?

  @@index([taskId, order])
}

model TaskLink {
  id        String   @id @default(cuid())
  sourceId  String
  source    Task     @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Task     @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      LinkType
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, type])
  @@index([targetId])
}

// ---------------------------------------------------------------------------
// Issues
// ---------------------------------------------------------------------------

model Issue {
  id               String      @id @default(cuid())
  key              String      @unique
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  status           IssueStatus @default(OPEN)
  severity         Severity    @default(MAJOR)
  priority         Priority    @default(MEDIUM)

  /// Environment / phase where the issue was observed.
  phaseId String?
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id])

  reporterId String
  reporter   User    @relation("IssueReporter", fields: [reporterId], references: [id])
  assigneeId String?
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// When work on the fix is meant to begin.
  startDate   DateTime?
  /// When the fix is due — the issue form's "end date".
  dueDate     DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  reopenCount Int       @default(0)

  /// The task that carries the fix. Kept as the primary one of `tasks`.
  taskId String?
  task   Task?   @relation("IssuePrimaryTask", fields: [taskId], references: [id], onDelete: SetNull)

  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels        IssueLabel[]
  watchers      IssueWatcher[]
  comments      Comment[]
  attachments   Attachment[]
  activities    ActivityLog[]
  notifications Notification[]
  hotfixes      Hotfix[]
  /// Every task raised to resolve this issue.
  tasks         Task[]         @relation("IssueTasks")

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([releaseId])
}

model IssueLabel {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

model IssueWatcher {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Releases, deployments & hotfixes
// ---------------------------------------------------------------------------

model Release {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version      String
  name         String?
  description  String?
  releaseNotes String?
  status       ReleaseStatus @default(PLANNED)
  isHotfix     Boolean       @default(false)

  /// Furthest phase this release has been deployed to.
  phaseId String?
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id])

  plannedDate DateTime?
  releasedAt  DateTime?

  createdById String
  createdBy   User   @relation("ReleaseCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  issues        Issue[]
  hotfixes      Hotfix[]
  deployments   Deployment[]
  comments      Comment[]
  attachments   Attachment[]
  activities    ActivityLog[]
  notifications Notification[]

  @@unique([projectId, version])
  @@index([projectId, status])
}

model Deployment {
  id           String           @id @default(cuid())
  releaseId    String
  release      Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  phaseId      String
  phase        ProjectPhase     @relation(fields: [phaseId], references: [id])
  status       DeploymentStatus @default(SUCCEEDED)
  notes        String?
  deployedAt   DateTime         @default(now())
  deployedById String
  deployedBy   User             @relation("DeploymentActor", fields: [deployedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([releaseId])
  @@index([phaseId])
}

model Hotfix {
  id          String       @id @default(cuid())
  key         String       @unique
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      HotfixStatus @default(REQUESTED)
  severity    Severity     @default(CRITICAL)
  priority    Priority     @default(CRITICAL)

  issueId   String?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  requestedById String
  requestedBy   User    @relation("HotfixRequester", fields: [requestedById], references: [id])
  assigneeId    String?
  assignee      User?   @relation("HotfixAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate    DateTime?
  approvedAt DateTime?
  fixedAt    DateTime?
  testedAt   DateTime?
  deployedAt DateTime?
  verifiedAt DateTime?
  rootCause  String?
  resolution String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  attachments   Attachment[]
  activities    ActivityLog[]
  notifications Notification[]

  @@index([projectId, status])
  @@index([assigneeId])
}

// ---------------------------------------------------------------------------
// Collaboration: comments, attachments, activity, notifications
// ---------------------------------------------------------------------------

model Comment {
  id         String     @id @default(cuid())
  body       String
  entityType EntityType
  authorId   String
  author     User       @relation(fields: [authorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  hotfixId  String?
  hotfix    Hotfix?  @relation(fields: [hotfixId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  mentions      CommentMention[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([taskId])
  @@index([issueId])
  @@index([hotfixId])
  @@index([releaseId])
  @@index([authorId])
}

model CommentMention {
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

model Attachment {
  id           String     @id @default(cuid())
  filename     String
  url          String
  publicId     String
  mimeType     String
  bytes        Int
  width        Int?
  height       Int?
  resourceType String     @default("image")
  entityType   EntityType
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  hotfixId  String?
  hotfix    Hotfix?  @relation(fields: [hotfixId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([issueId])
  @@index([hotfixId])
}

model ActivityLog {
  id         String     @id @default(cuid())
  /// e.g. "task.status_changed", "issue.reopened", "role.updated"
  action     String
  entityType EntityType
  entityId   String
  actorId    String?
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// { field, from, to, ... } — rendered into a human sentence on the client.
  meta       Json?
  createdAt  DateTime   @default(now())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  hotfixId  String?
  hotfix    Hotfix?  @relation(fields: [hotfixId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([issueId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  event     NotificationEvent
  title     String
  body      String?
  /// Deep link into the web app, e.g. "/projects/KIRI/tasks/KIRI-12"
  url       String?
  actorId   String?
  actor     User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  createdAt DateTime          @default(now())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  releaseId String?
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  hotfixId  String?
  hotfix    Hotfix?  @relation(fields: [hotfixId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationSetting {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    NotificationEvent
  web      Boolean           @default(true)
  telegram Boolean           @default(true)
  email    Boolean           @default(false)

  @@unique([userId, event])
}

model SavedFilter {
  id        String           @id @default(cuid())
  name      String
  scope     SavedFilterScope
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Serialised query params.
  query     Json
  isShared  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([projectId])
}

/// Enum used by DailyPlanItem: a bullet is either work in hand or something in the way.
enum DailyPlanItemKind {
  FOCUS
  BLOCKER
}

/// One person's plan for one calendar day — the "Today" list.
///
/// Kept deliberately small: a handful of bullets and an optional line of
/// context. It is a standup note, not a second task tracker, so a bullet may
/// point at a task but never replaces one.
model DailyPlan {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The day this covers, at midnight in the author's own timezone.
  date   DateTime @db.Date
  /// Optional free text: how the day is going, where help is wanted.
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DailyPlanItem[]

  @@unique([userId, date])
  @@index([date])
}

model DailyPlanItem {
  id     String    @id @default(cuid())
  planId String
  plan   DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  kind       DailyPlanItemKind @default(FOCUS)
  body       String
  isDone     Boolean           @default(false)
  /// When a blocker stopped being a blocker.
  resolvedAt DateTime?
  order      Int               @default(0)

  /// Optional link to the task this bullet is about.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([taskId])
}

/// Short-lived conversation state for the bot's multi-step flows.
///
/// This used to live in a `Map` in the process. A redeploy or a dev reload then
/// dropped whatever somebody was halfway through typing, and the bot ignored
/// their next message without a word — which is exactly what a half-written
/// comment disappearing looks like from the other end.
model TelegramPending {
  chatId    BigInt   @id
  /// A `PendingAction` from src/telegram/state.ts.
  action    Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
