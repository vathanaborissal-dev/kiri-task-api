# ---------------------------------------------------------------------------
# Database — Supabase Postgres. DATABASE_URL uses the transaction pooler
# (pgbouncer, port 6543); DIRECT_URL uses the session pooler (5432) and is
# only used by Prisma migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100
LOG_LEVEL=info
TRUST_PROXY=false

WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set a shared parent domain in production, e.g. .example.com
# COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Auth — must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
APP_JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=1

# ---------------------------------------------------------------------------
# Cloudinary — image and file attachments
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kiri-task

# ---------------------------------------------------------------------------
# Email (Brevo) — invitations, password resets, optional notifications
# ---------------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Kiri Task

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_IN_PROCESS=true
# Webhook mode (production). Leave empty to use long polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Scheduled jobs (deadline reminders, overdue sweeps)
# ---------------------------------------------------------------------------
ENABLE_SCHEDULER=true
REMINDER_CRON=30 7 * * 1-6
SCHEDULER_TIMEZONE=Asia/Phnom_Penh
# Required on Vercel. Use at least 16 random characters. Vercel sends this to
# the protected /api/cron/daily endpoint.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
